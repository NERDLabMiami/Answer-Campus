  go_to_next_node: 1
  executed_from_load: 0
  choices:
  - text: As long as they love and respect me, that's all I need.
    nextConversation: {fileID: 1265556544}
    useTraits: 0
    useEvents: 0
    useGame: 0
    traitRequirements: []
    eventRequirements: []
    footballRequirement:
      check: 0
      threshold: 0
  - text: Caring, smart, and respectful, but all red flags will turn green if they're
      a musician.
    nextConversation: {fileID: 1518236108}
    useTraits: 0
    useEvents: 0
    useGame: 0
    traitRequirements: []
    eventRequirements: []
    footballRequirement:
      check: 0
      threshold: 0
  - text: If they're hot, they'll be what I'm looking for.
    nextConversation: {fileID: 1896034571}
    useTraits: 0
    useEvents: 0
    useGame: 0
    traitRequirements: []
    eventRequirements: []
